# KipusPay — repo de especificación + monorepo de implementación (Arquitectura §1.1)
# Ignorar artefactos locales; los docs maestros y el código fuente siempre se versionan.

.DS_Store
Thumbs.db

# Node / build tooling
node_modules/
dist/
build/
*.log
*.tsbuildinfo
.pnpm-store/
.turbo/

# Frameworks y compilación de apps
apps/*/build/
apps/*/.svelte-kit/
apps/*/.wrangler/
apps/*/functions/
coverage/
*coverage/

# Secretos / entorno
.env
.env.*
!.env.example
*.pem
*.pfx

# Editor / SO
.idea/
.vscode/
*.swp

# Python de los checks (scripts/checks/*.py se importan entre sí y generan caché)
__pycache__/
*.pyc
