{
  "name": "@kipuspay/adapters-d1",
  "version": "0.0.0",
  "private": true,
  "description": "KipusPay — adaptador de persistencia D1 (repositorios, db.batch, migraciones)",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./process-offline-sale-atomic": "./src/process-offline-sale-atomic.ts",
    "./process-order-billing-atomic": "./src/process-order-billing-atomic.ts",
    "./process-customer-order-atomic": "./src/process-customer-order-atomic.ts",
    "./process-mobile-push-atomic": "./src/process-mobile-push-atomic.ts",
    "./process-recurring-sale-atomic": "./src/process-recurring-sale-atomic.ts",
    "./forecast-repository": "./src/forecast-repository.ts"
  },
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build": "true",
    "migrate:list": "ls -1 migrations/*.sql"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  },
  "dependencies": {
    "@kipuspay/adapters-stripe": "workspace:*",
    "@kipuspay/domain-analytics": "workspace:*",
    "@kipuspay/domain-billing": "workspace:*",
    "@kipuspay/domain-cash": "workspace:*",
    "@kipuspay/domain-customers": "workspace:*",
    "@kipuspay/domain-fiscal-pe": "workspace:*",
    "@kipuspay/domain-integrations": "workspace:*",
    "@kipuspay/domain-inventory": "workspace:*",
    "@kipuspay/domain-sales": "workspace:*",
    "@kipuspay/print-templates": "workspace:*"
  }
}
