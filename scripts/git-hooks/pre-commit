#!/usr/bin/env bash
# KipusPay — pre-commit hook: batería documental + append-only del ledger.
# Habilitado por scripts/bootstrap.sh (core.hooksPath = scripts/git-hooks).
set -eu
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo "== KipusPay pre-commit =="

# V-16 — invariante 4: el ledger es append-only. Misma implementación que CI.
python3 scripts/checks/ledger_append_only.py --cached || exit 1

bash scripts/verify.sh
