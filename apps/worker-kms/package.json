{
  "name": "@kipuspay/worker-kms",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --coverage=false",
    "test:unit": "vitest run --coverage=false",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging --keep-vars",
    "build": "tsc -p tsconfig.json --noEmit && wrangler deploy --dry-run --outdir=dist"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "eslint": "^10.8.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
