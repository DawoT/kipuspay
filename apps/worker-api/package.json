{
  "name": "@kipuspay/worker-api",
  "version": "0.0.0",
  "private": true,
  "description": "KipusPay — composition root de la API (Hono) en Cloudflare Workers.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build": "tsc -p tsconfig.json --noEmit && wrangler deploy --dry-run --outdir=dist"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  },
  "dependencies": {
    "@kipuspay/adapters-d1": "workspace:*",
    "@kipuspay/domain-cash": "workspace:*",
    "@kipuspay/domain-fiscal-pe": "workspace:*",
    "@kipuspay/domain-inventory": "workspace:*",
    "@kipuspay/domain-sales": "workspace:*",
    "hono": "^4.12.34"
  }
}
