{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kipuspay-worker-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "TENANT_KV",
      "id": "00000000000000000000000000000001",
      "preview_id": "00000000000000000000000000000001",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TENANT_STATE_DO",
        "class_name": "TenantState",
      },
      {
        "name": "BRANCH_KDS_HUB_DO",
        "class_name": "BranchKdsHub",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1-tenant-state",
      "new_sqlite_classes": ["TenantState"],
    },
    {
      "tag": "v2-branch-kds-hub",
      "new_sqlite_classes": ["BranchKdsHub"],
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kipuspay-local",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "../../packages/adapters-d1/migrations",
    },
    {
      "binding": "DR_DB",
      "database_name": "kipuspay-dr",
      "database_id": "00000000-0000-0000-0000-0000000000d1",
      "migrations_dir": "../../packages/adapters-d1/migrations",
    },
    {
      "binding": "WEBHOOK_EVENTS_DB",
      "database_name": "kipuspay-local",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "../../packages/adapters-d1/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "kipuspay-backups",
    },
  ],
  "ai_bindings": [
    {
      "binding": "AI",
    },
  ],
  "workflows": [
    {
      "binding": "BACKUP_WORKFLOW",
      "name": "kipuspay-data-backup",
      "class_name": "BackupWorkflow",
      "limits": {
        "steps": 10000,
      },
    },
  ],
  "services": [
    {
      "binding": "BACKUP_KMS",
      "service": "kipuspay-worker-kms",
      "entrypoint": "BackupKmsService",
    },
    {
      "binding": "PUSH_KMS",
      "service": "kipuspay-worker-kms",
      "entrypoint": "PushTransportService",
    },
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS_ENGINE",
      "dataset": "kipuspay_analytics",
    },
  ],
  "triggers": {
    "crons": ["0 8 * * *", "30 8 * * *", "*/5 * * * *", "30 3 * * *"],
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 },
  },
  "vars": {
    "FQDN": "https://api.kipuspay.local",
    "FEATURE_ACID_OFFLINE_SALE": "0",
    "FEATURE_FISCAL_CPE": "0",
    "FEATURE_FISCAL_RC": "0",
    "FEATURE_FISCAL_CIRCUIT_BREAKER": "0",
    "FEATURE_FISCAL_TRANSPORT_PLUGINS": "0",
    "FEATURE_BILLING_USAGE_OVERAGE": "0",
    "FEATURE_CPE_PORTAL": "0",
    "FEATURE_OFFLINE_SYNC": "0",
    "FEATURE_POS_CHECKOUT": "0",
    "FEATURE_PRINT_TEMPLATES": "0",
    "FEATURE_VITRINA": "0",
    "FEATURE_LEDGER_AR_AP": "0",
    "FEATURE_PURCHASING_ORDERS": "0",
    "FEATURE_CASH_EXPENSES": "0",
    "FEATURE_CASH_BLIND_Z": "0",
    "FEATURE_ORDERS_KDS": "0",
    "FEATURE_STOCK_TRANSFERS": "0",
    "FEATURE_PURCHASING_PARTIAL_RECEIVE": "0",
    "FEATURE_INVENTORY_BATCHES": "0",
    "FEATURE_INVENTORY_BOM": "0",
    "FEATURE_PRICING_LISTS": "0",
    "FEATURE_OWNER_MODE": "0",
    "FEATURE_OWNER_PUSH": "0",
    "FEATURE_REPORTING_ROLLUPS": "0",
    "FEATURE_REPORTING_CATALOG": "0",
    "FEATURE_REPORTING_EXPORT": "0",
    "FEATURE_SALES_RETURNS": "0",
    "FEATURE_PURCHASING_THREE_WAY": "0",
    "FEATURE_PRICING_PROMOTIONS": "0",
    "FEATURE_CATALOG_VARIANTS": "0",
    "FEATURE_CATALOG_UOM": "0",
    "FEATURE_SALES_LAYAWAY": "0",
    "FEATURE_LEDGER_CHART_OF_ACCOUNTS": "0",
    "FEATURE_SALES_QUOTES": "0",
    "FEATURE_PURCHASING_RETURNS": "0",
    "FEATURE_LEDGER_STORE_CREDIT": "0",
    "FEATURE_SALES_INSTALLMENTS": "0",
    "FEATURE_SALES_COMMISSIONS": "0",
    "FEATURE_INVENTORY_LOCATIONS": "0",
    "FEATURE_INVENTORY_SERIALS": "0",
    "FEATURE_INVENTORY_SCALE": "0",
    "FEATURE_CATALOG_PRICE_LABELS": "0",
    "FEATURE_DATA_BACKUP": "0",
    "FEATURE_PLATFORM_DR": "0",
    "FEATURE_ANALYTICS_AGENTIC_INSIGHTS": "0",
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct",
    "FEATURE_ORDERS_CUSTOMER_ORDERS": "0",
    "FEATURE_SALES_RECURRING": "0",
    "RECURRING_MANUAL_RUN_ENABLED": "0",
    "FEATURE_MOBILE_PUSH": "0",
    "FEATURE_CLIENT_MOBILE_POS": "0",
    "PUSH_VAPID_PUBLIC_KEY": "",
    "FEATURE_LPDP": "0",
  },
}
