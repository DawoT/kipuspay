{
  "name": "@kipuspay/worker-fiscal",
  "version": "0.0.0",
  "private": true,
  "description": "KipusPay — worker fiscal: clasificación de CDR SUNAT y emisión (PSE KipusPay).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build": "tsc -p tsconfig.json --noEmit && wrangler deploy --dry-run --outdir=dist"
  },
  "dependencies": {
    "@kipuspay/adapters-sunat": "workspace:*",
    "@kipuspay/domain-fiscal-pe": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.118.0"
  }
}
